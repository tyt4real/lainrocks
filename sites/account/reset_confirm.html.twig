{% extends "base.html.twig" %}
{% import "account/_form.html.twig" as form %}

{% block title %}{{ t('account.reset_confirm.title') }}{% endblock %}

{% block content %}

    <section class="greeting">
        <p class="greeting-msg">{{ t('account.reset_confirm.heading') }}</p>
    </section>

    <section class="site-about">
        <p class="about-msg">{{ t('account.reset_confirm.sub') }}</p>
    </section>

    {{ form.flash(flash) }}

    <section class="site-me card">
        <h2>{{ t('account.reset_confirm.heading') }}</h2>
        <form method="POST" action="?page=account&action=reset-confirm" class="acct-form" novalidate>
            <input type="hidden" name="uid"   value="{{ uid }}">
            <input type="hidden" name="token" value="{{ token }}">
            {{ form.field('New password',     'new_password',     'password', '', '', true) }}
            <p class="acct-hint">{{ t('account.reset_confirm.password_hint') }}</p>
            {{ form.field('Confirm password', 'confirm_password', 'password', '', '', true) }}
            <div class="acct-actions">
                <button type="submit" class="cta">{{ t('account.reset_confirm.btn') }}</button>
            </div>
        </form>
    </section>

{% endblock %}
