{% extends "base.html.twig" %}
{% import "account/_form.html.twig" as form %}

{% block title %}{{ t('account.login.title') }}{% endblock %}

{% block content %}
{{ renderNavbar() }}

<div class="page page--account">
    <div class="acct-wrap">

        <div class="acct-header">
            <h1 class="acct-title">{{ t('account.login.welcome') }}</h1>
            <p class="acct-sub">{{ t('account.login.sub') }}</p>
        </div>

        {% if registered %}
            <div class="acct-flash acct-flash--ok">{{ t('account.login.registered') }}</div>
        {% endif %}
        {% if reset is defined and reset %}
            <div class="acct-flash acct-flash--ok">{{ t('account.login.reset_ok') }}</div>
        {% endif %}

        {{ form.flash(flash) }}

        <div class="card acct-card">
            <h2 class="card__heading">{{ t('account.login.heading') }}</h2>

            {% if authelia_login_url is defined %}
                <a class="acct-btn acct-btn--primary acct-btn--full" href="{{ authelia_login_url }}">{{ t('account.login.authelia_btn') }}</a>
            {% else %}
                <p class="acct-alt">{{ t('account.login.authelia_unavailable') }}</p>
            {% endif %}

            {% if ldap_enabled is defined and ldap_enabled %}
            <div class="acct-divider"><span>{{ t('account.login.legacy') }}</span></div>

            <form method="POST" action="?page=account&action=login" class="acct-form" novalidate>
                {% if redirect %}
                    <input type="hidden" name="redirect" value="{{ redirect }}">
                {% endif %}

                {{ form.field('Username', 'uid', 'text', '', '', true) }}
                {{ form.field('Password', 'password', 'password', '', '', true) }}

                <div class="acct-actions">
                    <button type="submit" class="acct-btn">{{ t('account.login.btn_login') }}</button>
                    <a class="acct-link" href="?page=account&action=reset-password">{{ t('account.login.forgot_password') }}</a>
                </div>
            </form>
            {% endif %}
        </div>

        <p class="acct-alt">{{ t('account.login.no_account') }} <a href="?page=account&action=register">{{ t('account.login.register_link') }}</a></p>

    </div>
</div>
{% endblock %}
