{% extends "base.html.twig" %}
{% import "account/_form.html.twig" as form %}

{% block title %}{{ t('account.reset_request.title') }}{% endblock %}

{% block content %}
{{ renderNavbar() }}

<div class="page page--account">
    <div class="acct-wrap">

        <div class="acct-header">
            <h1 class="acct-title">{{ t('account.reset_request.heading') }}</h1>
            <p class="acct-sub">{{ t('account.reset_request.sub') }}</p>
        </div>

        {{ form.flash(flash) }}

        <div class="card acct-card">
            <h2 class="card__heading">{{ t('account.reset_request.heading') }}</h2>
            <form method="POST" action="?page=account&action=reset-password" class="acct-form" novalidate>
                {{ form.field('Username', 'uid', 'text', '', 'lain', true) }}
                <div class="acct-actions">
                    <button type="submit" class="acct-btn">{{ t('account.reset_request.btn') }}</button>
                    <a class="acct-link" href="?page=account&action=login">← Back to login</a>
                </div>
            </form>
        </div>

    </div>
</div>
{% endblock %}
