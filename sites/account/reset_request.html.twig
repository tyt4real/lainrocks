{% extends "base.html.twig" %}
{% import "account/_form.html.twig" as form %}

{% block title %}{{ t('account.reset_request.title') }}{% endblock %}

{% block content %}

    <section class="greeting">
        <p class="greeting-msg">{{ t('account.reset_request.heading') }}</p>
    </section>

    <section class="site-about">
        <p class="about-msg">{{ t('account.reset_request.sub') }}</p>
    </section>

    {{ form.flash(flash) }}

    <section class="site-me card">
        <h2>{{ t('account.reset_request.heading') }}</h2>
        <form method="POST" action="?page=account&action=reset-password" class="acct-form" novalidate>
            {{ form.field('Username', 'uid', 'text', '', 'lain', true) }}
            <div class="acct-actions">
                <button type="submit" class="cta">{{ t('account.reset_request.btn') }}</button>
                <a class="cta cta--outline" href="?page=account&action=login">← Back to login</a>
            </div>
        </form>
    </section>

{% endblock %}
