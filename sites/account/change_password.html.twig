{% extends "base.html.twig" %}
{% import "account/_form.html.twig" as form %}

{% block title %}{{ t('account.change_password.title') }}{% endblock %}

{% block content %}

    <section class="greeting">
        <p class="greeting-msg">{{ t('account.change_password.heading') }}</p>
    </section>

    <section class="site-about">
        <p class="about-msg">{{ t('account.change_password.sub') }}</p>
    </section>

    {{ form.flash(flash) }}

    <section class="site-me card">
        <h2>{{ t('account.change_password.heading') }}</h2>
        <form method="POST" action="?page=account&action=change-password" class="acct-form" novalidate>
            {{ form.field('Current password', 'current_password', 'password', '', '', true) }}
            {{ form.field('New password',     'new_password',     'password', '', '', true) }}
            <p class="acct-hint">{{ t('account.change_password.password_hint') }}</p>
            {{ form.field('Confirm new password', 'confirm_password', 'password', '', '', true) }}
            <div class="acct-actions">
                <button type="submit" class="cta">{{ t('account.change_password.btn') }}</button>
                <a class="cta cta--outline" href="?page=account&action=profile">← Back to profile</a>
            </div>
        </form>
    </section>

{% endblock %}
