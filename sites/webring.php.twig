{% extends "base.html.twig" %}

{% block title %}{{ t('webring.title') }}{% endblock %}
{% block head %}{{ parent() }}{% endblock %}

{% block content %}

    <div class="page page--webring">

        <section class="card" id="lainring">
            <h2 class="card__heading">{{ t('webring.heading') }}</h2>
            <div class="lainring-wrap">
                {{ renderLainring() }}
            </div>
            <p class="lainring-credit">
                {{ t('webring.credit') }}
            </p>
        </section>

    </div>

{% endblock %}
