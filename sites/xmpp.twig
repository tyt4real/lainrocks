            You can create an account using any XMPP client that supports account registration, for example
            <a href="https://conversations.im/" target="_blank">{{ t('xmpp.about_text3') }}</a> for Android or
            <a href="https://www.coyim.org/" target="_blank">{{ t('xmpp.about_text4') }}</a> for desktop.
            {{ t('xmpp.about_text5') }}
        </p>
        <p class="about-msg">
            {{ t('xmpp.about_text6') }}
            <code class="onion-addr tabular-nums">26cp7rchjrhtet4jbcijs5oxtfu52w435f4swmya7p6xr4xxxdqx23yd.onion</code>.
            {{ t('xmpp.about_text7') }}
