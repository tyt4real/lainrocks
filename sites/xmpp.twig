            {{ t('xmpp.about_text10') }}
            {{ t('xmpp.about_text11') }}
            <a href="mailto:tyt4real@protonmail.com">tyt4real@protonmail.com</a>.
            {{ t('xmpp.about_text12') }}
            {{ t('xmpp.about_text13') }}
            <a href="./sites/tos.html" target="_blank">{{ t('xmpp.about_text14') }}</a>
            {{ t('xmpp.about_text15') }}
            <a href="./sites/tos.ru.html" target="_blank">{{ t('xmpp.about_text16') }}</a>.
        </p>
        <p class="about-msg">{{ t('xmpp.about_text17') }}</p>
