{% extends "base.html.twig" %}

{% block title %}{{ t('about.title') }}{% endblock %}
{% block head %}{{ parent() }}{% endblock %}

{% block content %}

    <!-- Main feature: who am I -->
    <section class="greeting">
        <p class="greeting-msg">{{ t('about.who_heading') }}</p>
    </section>

    <!-- Handles -->
    <section class="site-me">
        <h2>{{ t('about.who_heading') }}</h2>
        <p>{{ t('about.intro') }}</p>
        <blockquote class="about-quote">{{ t('about.quote') }}</blockquote>
        <ul class="info-list">
            <li>{{ t('about.handle.label') }} <strong>tyt4real</strong></li>
            <li><span class="handle-list__label">{{ t('about.handle.fediverse') }}</span> <a href="https://comp.lain.la/users/tyt4real">tyt4real@comp.lain.la</a></li>
            <li><span class="handle-list__label">{{ t('about.handle.xmpp') }}</span> <a href="xmpp:tyt4real@lain.rocks">tyt4real@lain.rocks</a></li>
            <li><span class="handle-list__label">{{ t('about.handle.github') }}</span> <a href="https://github.com/tyt4real">tyt4real</a></li>
            <li><span class="handle-list__label">{{ t('about.handle.twitter') }}</span> <a href="https://x.com/tyt4fake">tyt4</a></li>
        </ul>
    </section>

    <!-- About me -->
    <section class="site-about">
        <h2>{{ t('about.about_me.heading') }}</h2>
        <p class="about-msg">{{ t('about.about_me.text') }}</p>
        <p class="lain-sign">{{ t('about.about_me.lain_sign') }}</p>
    </section>

    <!-- Contact -->
    <section class="site-me">
        <h2>{{ t('about.contact.heading') }}</h2>
        <p>{{ t('about.contact.text') }}</p>
        <ul class="contact-list">
            <li>
                <span class="contact-list__label">{{ t('about.contact.email') }}</span>
                <a href="mailto:tyt4real@protonmail.com">tyt4real@protonmail.com</a>
                <ul class="contact-list__sub">
                    <li>{{ t('about.contact.pgp_key') }} <a href="../special/public.asc" target="_blank">here</a>.</li>
                    <li>{{ t('about.contact.fingerprint') }} <code class="tabular-nums">1CB2748D8D6DED9F</code></li>
                </ul>
            </li>
            <li>
                <span class="contact-list__label">{{ t('about.contact.irc') }}</span>
                <span>Most of the time, I'm reachable on <code>#lainchan @ irc.0xfdb.xyz +6697</code></span>
            </li>
            <li>
                <span class="contact-list__label">{{ t('about.contact.xmpp') }}</span>
                <span>
                    <a href="xmpp:tyt4real@lain.rocks">tyt4real@lain.rocks</a> or
                    <a href="xmpp:tyt4real@xmpp.jp">tyt4real@xmpp.jp</a>
                </span>
            </li>
        </ul>
    </section>

{% endblock %}
