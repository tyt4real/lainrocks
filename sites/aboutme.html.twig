{% extends "base.html.twig" %}

{% block title %}{{ tr('about_title') }}{% endblock %}
{% block head %}{{ parent() }}{% endblock %}

{% block content %}

    {{ renderNavbar() }}

    <div class="page page--about">

        <section class="card about-hero" id="who">
            <h2 class="card__heading">{{ tr('who_am_i') }}</h2>
            <div class="about-hero__body">
                <div class="about-hero__photo">
                    {{ renderRandomMeIRLImage() }}
                </div>
                <div class="about-hero__text">
                    <p>{{ tr('about_me_intro') }}</p>
                    <blockquote class="about-quote">>who needs compiler warnings when you have this guy</blockquote>
                    <ul class="handle-list">
                        <li>My handle on most places is <em>tyt4real</em></li>
                        <li><span class="handle-list__label">{{ tr('fediverse') }}</span> <a href="https://comp.lain.la/users/tyt4real">tyt4real@comp.lain.la</a></li>
                        <li><span class="handle-list__label">{{ tr('xmpp') }}</span> <a href="xmpp:tyt4real@lain.rocks">tyt4real@lain.rocks</a></li>
                        <li><span class="handle-list__label">{{ tr('github') }}</span> <a href="https://github.com/tyt4real">tyt4real</a></li>
                        <li><span class="handle-list__label">{{ tr('twitter') }}</span> <a href="https://x.com/tyt4fake">tyt4</a></li>
                    </ul>
                </div>
            </div>
        </section>

        <div class="about-grid">

            <section class="card" id="about-me">
                <h2 class="card__heading">{{ tr('about_me') }}</h2>
                <p>
                    Since a <em>very</em> young age I loved messing around with computers and hardware in general.
                    When I was about 6 I learnt to code in Java for purpose of writing Minecraft server plugins and mods.
                    Since then I learnt many other languages such as C, PHP, Javascript, Typescript and others,
                    although I suck at graphical design, I try my best.
                    Since I begun using the Wired, I switched handles and nicknames many times but I hope my current
                    identity will stay with me for a <em>long</em> time.
                    I have done tons of small side projects, in all of which I've lost interest.
                    This site however I hope will keep me entertained for a very <em>long</em> time.
                </p>
                <p class="lain-sign">{{ tr('lets_all_love_lain') }}</p>
            </section>

            <section class="card" id="contact">
                <h2 class="card__heading">{{ tr('contact_me') }}</h2>
                <p>{{ tr('im_flattered') }}</p>
                <ul class="contact-list">
                    <li>
                        <span class="contact-list__label">{{ tr('email') }}</span>
                        <div>
                            <a href="mailto:tyt4real@protonmail.com">tyt4real@protonmail.com</a>
                            <ul class="contact-list__sub">
                                <li>{{ tr('my_public_pgp_key') }}: <a href="https://lain.rocks/special/public.asc" target="_blank">{{ tr('here') }}</a>.</li>
                                <li>{{ tr('key_fingerprint') }}: <code>1CB2748D8D6DED9F</code></li>
                            </ul>
                        </div>
                    </li>
                    <li>
                        <span class="contact-list__label">{{ tr('irc') }}</span>
                        <span>{{ tr('most_of_the_time_im_reachable') }} <code>#lainchan @ irc.0xfdb.xyz +6697</code></span>
                    </li>
                    <li>
                        <span class="contact-list__label">{{ tr('xmpp') }}</span>
                        <span>
                            <a href="xmpp:tyt4real@lain.rocks">{{ tr('tyt4real_at_lain_rocks') }}</a> or
                            <a href="xmpp:tyt4real@xmpp.jp">{{ tr('tyt4real_at_xmpp_jp') }}</a>
                        </span>
                    </li>
                    <li>
                        <span class="contact-list__label">{{ tr('discord') }}</span>
                        <a href="https://spyware.neocities.org/articles/discord.html">
                            <img src="../images/discord-no-way-2.gif" alt="{{ tr('discord_no_way') }}" class="badge-gif" />
                        </a>
                    </li>
                </ul>
            </section>

        </div>

        <section class="card about-banner">
            <img src="../images/connectlain.jpg" alt="{{ tr('connect_to_the_wired') }}" />
        </section>

    </div>

{% endblock %}