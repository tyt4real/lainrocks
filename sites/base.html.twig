<!DOCTYPE html>
<html lang="{{ locale }}" data-theme="cyberpunk">
    <head>
        {% block head %}
            <meta charset="UTF-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <meta name="description" content="{{ t('meta.description') }}" />
            <meta name="keywords" content="{{ t('meta.keywords') }}" />
            <meta name="author" content="{{ t('meta.author') }}" />
            {% set canonicalPath = {
                'home': '/',
                'about': '/about',
                'LainOS': '/lainos',
                'Jabber Server': '/jabber'
            }[current_page]|default('/') %}
            <link rel="canonical" href="https://lain.rocks{{ canonicalPath }}" />
            <link rel="icon" type="image/x-icon" href="../images/favicon.ico" />
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
            <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
            <link id="account-css" href="../css/account.css" rel="stylesheet"/>
            <link id="theme-css" href="../css/cyberpunk.css" rel="stylesheet" />
            <title>lain.rocks | {% block title %}{% endblock %}</title>
        {% endblock %}
    </head>
    <body>

        <div class="body-container">

            <header onclick="window.location = './?page=home'">
                <h1 class="header-title">{{ t('header.title') }}</h1>
                <p class="header-para">{{ t('header.sub') }}</p>
            </header>

            <nav>
                <ul class="navbar-list">
                    {% for link in navbarLinks %}
                        <li class="navbar-item"><a href="{{ link.href }}" target="{{ link.target }}">{{ link.label }}</a></li>
                    {% endfor %}
                </ul>
            </nav>

            <main>
                {% block content %}{% endblock %}
            </main>

            <footer>Thanks for the visit.
                <span class="footer-eof">EOF</span>
                <div class="site-footer__locale">
                    <span class="theme-label">{{ t('nav.locale') }}</span>
                    <div class="locale-selector">
                        <a href="?lang=en" class="locale-btn{% if locale == 'en' %} locale-btn--active{% endif %}">EN</a>
                        <a href="?lang=ru" class="locale-btn{% if locale == 'ru' %} locale-btn--active{% endif %}">RU</a>
                        <a href="?lang=fr" class="locale-btn{% if locale == 'fr' %} locale-btn--active{% endif %}">FR</a>
                        <a href="?lang=pl" class="locale-btn{% if locale == 'pl' %} locale-btn--active{% endif %}">PL</a>
                    </div>
                </div>
            </footer>

        </div>

        <script src="https://satori.lain.rocks/js/e7858184-3501-4ff3-ae9b-09422cb4061c" defer></script>
        <script src="../js/styleinit.js"></script>
        <script src="../js/themeManager.js"></script>
    </body>
</html>
