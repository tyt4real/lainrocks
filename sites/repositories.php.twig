{% extends "base.html.twig" %}

{% block title %}{{ tr('repositories_page') }}{% endblock %}
{% block head %}{{ parent() }}{% endblock %}

{% block content %}

    {{ renderNavbar() }}

    <div class="page page--repos">

        <section class="card" id="lainos-about">
            <h2 class="card__heading">{{ tr('lainos_project') }}</h2>
            <p>{{ tr('lainos_description') }}</p>
            <p>
                {{ tr('visit_project_website') }} <a href="https://lainos.dev/">{{ tr('here') }}</a> and its Git repository <a href="https://gitlab.com/lainos">{{ tr('here') }}</a>.
            </p>
            <p>{{ tr('official_software_mirror') }}</p>
        </section>

        <section class="card" id="mirror-list">
            <h2 class="card__heading">{{ tr('lainos_software_mirror_list') }}</h2>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>{{ tr('name') }}</th>
                            <th>{{ tr('mirror_url') }}</th>
                            <th>{{ tr('tor_mirror_url') }}</th>
                            <th>{{ tr('description') }}</th>
                            <th>{{ tr('is_online') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="table-name">{{ tr('wired_repo') }}</td>
                            <td><a href="https://lain.rocks/repos/wired/">{{ tr('lain_rocks_repos_wired') }}</a></td>
                            <td><a href="http://lainrbhc4y67y4qfarb637f5t5m4kfsw7jkbocs3loazvtksxgtf6oid.onion/repos/wired/" class="onion-link">{{ tr('.onion_repos_wired') }}</a></td>
                            <td>{{ tr('repository_pentesting_tools') }}</td>
                            <td><span class="status-val">{{ isSiteOnline('https://lain.rocks/repos/wired') }}</span></td>
                        </tr>
                        <tr>
                            <td class="table-name">{{ tr('lain_repo') }}</td>
                            <td><a href="https://lain.rocks/repos/lain/">{{ tr('lain_rocks_repos_lain') }}</a></td>
                            <td><a href="http://lainrbhc4y67y4qfarb637f5t5m4kfsw7jkbocs3loazvtksxgtf6oid.onion/repos/lain/" class="onion-link">{{ tr('.onion_repos_lain') }}</a></td>
                            <td>{{ tr('repository_general_software') }}</td>
                            <td><span class="status-val">{{ isSiteOnline('https://lain.rocks/repos/lain') }}</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="card" id="mirror-stats">
            <h2 class="card__heading">{{ tr('mirror_statistics') }}</h2>
            <dl class="stats-list">
                <div class="stats-list__row">
                    <dt>{{ tr('mirror_size') }}</dt>
                    <dd>{{ calculateMirrorDiskSpace() }}</dd>
                </div>
                <div class="stats-list__row">
                    <dt>{{ tr('last_update') }}</dt>
                    <dd>{{ getLastMirrorUpdate() }}</dd>
                </div>
            </dl>
        </section>

    </div>

{% endblock %}